# --- Database ---
# Default: SQLite, zero setup, file lives at apps/web/prisma/dev.db
DATABASE_URL="file:./dev.db"
# Production alternative (see ARCHITECTURE.md §0 for the Postgres+pgvector swap):
# DATABASE_URL="postgresql://user:password@localhost:5432/needly"

# --- Auth ---
# Long random string used to sign session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="replace-with-a-long-random-string"

# --- AI provider ---
# Optional. If unset, the app runs fully offline using the deterministic
# HeuristicAIProvider (rule-based intent + Tool DNA matching, no network calls).
# If set, AnthropicAIProvider is used automatically for the AI paths that
# genuinely need a language model (novel structure generation, free-form
# natural-language mutation commands).
ANTHROPIC_API_KEY=""

# --- Storage (dev = local filesystem under apps/web/.uploads) ---
UPLOADS_DIR="./.uploads"
MAX_UPLOAD_BYTES="5242880"

# --- App ---
NODE_ENV="development"
PORT="3000"
