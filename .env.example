# --- Database ---
# Default: SQLite, zero setup, file lives at apps/web/prisma/dev.db
DATABASE_URL="file:./dev.db"
# Production alternative (see ARCHITECTURE.md §0 for the Postgres+pgvector swap):
# DATABASE_URL="postgresql://user:password@localhost:5432/needly"

# --- Auth ---
# Long random string used to sign session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="replace-with-a-long-random-string"

# --- AI provider ---
# Optional. If neither key below is set, the app runs fully offline using the
# deterministic HeuristicAIProvider (rule-based intent + Tool DNA matching,
# no network calls — new apps are matched against the fixed Tool DNA catalog,
# never composed from the primitive registry).
# If ANTHROPIC_API_KEY is set, AnthropicAIProvider is used. Otherwise, if
# GEMINI_API_KEY is set, GeminiAIProvider is used. Either gives you the real
# dynamic planner: new apps are composed from the primitive registry
# (packages/core/src/ai/generativePlanner.ts) instead of picked from a
# template.
ANTHROPIC_API_KEY=""
GEMINI_API_KEY=""

# --- Storage (dev = local filesystem under apps/web/.uploads) ---
UPLOADS_DIR="./.uploads"
MAX_UPLOAD_BYTES="5242880"

# --- App ---
NODE_ENV="development"
PORT="3000"
